{
  "$id": "public-contract.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public Audit Contract",
  "$comment": "Validates the document printed by `audit_council.py describe --json` (pillar F). Only validator-supported keywords are used; frozen value equality with state.schema.json / budgets.DEFAULT_BUDGETS is enforced by drift tests, not duplicated here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "compatibility_policy",
    "environment_modes",
    "model_roles",
    "independence_rules",
    "artifact_semantics",
    "completeness_states",
    "environment_integrity",
    "governor_constraints",
    "brief_target_metadata",
    "runtime_capabilities",
    "known_limitations"
  ],
  "properties": {
    "protocol_version": {
      "type": "string",
      "const": "2.0"
    },
    "compatibility_policy": {
      "type": "string",
      "minLength": 1
    },
    "environment_modes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "string",
        "enum": ["AUTO", "CURRENT", "RELEASE", "HISTORICAL"]
      }
    },
    "model_roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opus", "codex"],
      "properties": {
        "opus": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "role", "independent_pass"],
          "properties": {
            "model": {"type": "string", "minLength": 1},
            "role": {"type": "string", "minLength": 1},
            "independent_pass": {"const": true}
          }
        },
        "codex": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model",
            "reasoning_effort",
            "role",
            "read_only_sandbox",
            "independent_pass"
          ],
          "properties": {
            "model": {"type": "string", "minLength": 1},
            "reasoning_effort": {"type": "string", "minLength": 1},
            "role": {"type": "string", "minLength": 1},
            "read_only_sandbox": {"const": true},
            "independent_pass": {"const": true}
          }
        }
      }
    },
    "independence_rules": {
      "type": "array",
      "minItems": 3,
      "items": {"type": "string", "minLength": 1}
    },
    "artifact_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_artifacts",
        "evidence_model",
        "raw_outputs_preserved"
      ],
      "properties": {
        "canonical_artifacts": {
          "type": "array",
          "minItems": 12,
          "items": {
            "type": "string",
            "pattern": "^[0-9]{2}-[a-z0-9-]+\\.json$"
          }
        },
        "evidence_model": {"type": "string", "minLength": 1},
        "raw_outputs_preserved": {"const": true}
      }
    },
    "completeness_states": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z_]*$"
      }
    },
    "environment_integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding",
        "failure_taxonomy",
        "environment_failure_yields_product_verdict",
        "zero_model_calls_on_environment_failure"
      ],
      "properties": {
        "binding": {"type": "string", "minLength": 1},
        "failure_taxonomy": {
          "type": "array",
          "minItems": 9,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z_]*$"
          }
        },
        "environment_failure_yields_product_verdict": {"const": false},
        "zero_model_calls_on_environment_failure": {"const": true}
      }
    },
    "governor_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_successful_stages_per_phase",
        "max_total_successful_stages",
        "max_attempts_per_phase",
        "max_repairs_per_phase",
        "specialists_default",
        "specialists_normal_cap",
        "specialists_hard_cap",
        "max_specialist_turns",
        "max_dynamic_probes",
        "cached_evidence_policy",
        "force_fresh_release_gates",
        "omissions"
      ],
      "properties": {
        "max_successful_stages_per_phase": {"type": "integer", "minimum": 0},
        "max_total_successful_stages": {"type": "integer", "minimum": 0},
        "max_attempts_per_phase": {"type": "integer", "minimum": 0},
        "max_repairs_per_phase": {"type": "integer", "minimum": 0},
        "specialists_default": {"type": "integer", "minimum": 0},
        "specialists_normal_cap": {"type": "integer", "minimum": 0},
        "specialists_hard_cap": {"type": "integer", "minimum": 0},
        "max_specialist_turns": {"type": "integer", "minimum": 0},
        "max_dynamic_probes": {"type": "integer", "minimum": 0},
        "cached_evidence_policy": {"type": "string", "minLength": 1},
        "force_fresh_release_gates": {"type": "boolean"},
        "omissions": {"type": "string", "minLength": 1}
      }
    },
    "brief_target_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "prose_paths_are"],
      "properties": {
        "format": {"type": "string", "minLength": 1},
        "prose_paths_are": {"type": "string", "minLength": 1}
      }
    },
    "runtime_capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codex_invocation",
        "auth",
        "claude_path_confinement",
        "codex_write_confinement",
        "sandbox_preflight",
        "evidence_staging",
        "codex_read_confinement",
        "resumable",
        "write_scope"
      ],
      "properties": {
        "codex_invocation": {"type": "string", "minLength": 1},
        "auth": {"type": "string", "minLength": 1},
        "claude_path_confinement": {"type": "string", "minLength": 1},
        "codex_write_confinement": {"type": "string", "minLength": 1},
        "codex_read_confinement": {"type": "string", "minLength": 1},
        "resumable": {"const": true},
        "write_scope": {"type": "string", "minLength": 1},
        "sandbox_preflight": {"type": "string", "minLength": 1},
        "evidence_staging": {"type": "string", "minLength": 1}
      }
    },
    "known_limitations": {
      "type": "array",
      "minItems": 4,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
