{
  "$id": "evidence-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence Record (provenance-bound evidence store, v2 pillar B)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "kind",
    "repository_fingerprint_sha256",
    "environment_binding_digest",
    "input_digest",
    "tool",
    "command_or_query",
    "produced_at",
    "freshness_policy",
    "result_digest",
    "result_location",
    "producer",
    "visibility",
    "validity_scope",
    "deterministic",
    "reproducible"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^ev-[0-9a-f]{16}$"
    },
    "kind": {
      "enum": [
        "REPO_FACT",
        "FILE_EXCERPT",
        "SEARCH_RESULT",
        "DEPENDENCY_QUERY",
        "GRAPH_RESULT",
        "BUILD_RESULT",
        "LINT_RESULT",
        "TEST_RESULT",
        "COVERAGE_RESULT",
        "GIT_DIFF",
        "DETERMINISTIC_PROBE",
        "PACKAGE_SMOKE",
        "TOOL_VERSION"
      ]
    },
    "repository_fingerprint_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "environment_binding_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "command_or_query": {
      "type": "string",
      "minLength": 1
    },
    "produced_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "freshness_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "ttl_sec",
        "invalidated_by"
      ],
      "properties": {
        "class": {
          "enum": [
            "FRESH_REQUIRED",
            "CACHEABLE"
          ]
        },
        "ttl_sec": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "invalidated_by": {
          "type": "array",
          "items": {
            "enum": [
              "tracked_change",
              "head_change",
              "binding_change"
            ]
          }
        }
      }
    },
    "result_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "result_location": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "visibility": {
      "enum": [
        "SHARED_MECHANICAL",
        "AUDITOR_PRIVATE",
        "POST_BARRIER_SHARED"
      ]
    },
    "validity_scope": {
      "enum": [
        "RUN",
        "REPOSITORY",
        "GLOBAL"
      ]
    },
    "deterministic": {
      "type": "boolean"
    },
    "reproducible": {
      "type": "boolean"
    }
  }
}
